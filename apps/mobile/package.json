{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "description": "React Native app for JK-B2A16S active balancer monitoring (Android/iOS)",
  "license": "MIT",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gen:fixtures": "node scripts/gen-fixtures.mjs",
    "build:android": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-ble-plx": "3.5.1",
    "react-native-safe-area-context": "5.11.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@babel/preset-env": "7.29.14",
    "@babel/runtime": "7.29.14",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "19.2.18",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
