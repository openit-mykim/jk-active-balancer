{
  "name": "jk-active-balancer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JK-B2A16S (JK04/BLE) active balancer monitor for Android, iOS and Chrome (Web Bluetooth)",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "pnpm --filter web build",
    "check:pins": "node scripts/check-pins.mjs",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
